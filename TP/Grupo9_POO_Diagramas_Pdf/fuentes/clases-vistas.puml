@startuml
!include estilo.iuml
title Diagrama de clases: vistas y arranque

class App {
  main() : modo completo, servidor o cliente
}

class Arranque {
  arma el gestor y levanta el servidor
}

package "Consola" {
  class MenuPorRol {
    menu armado con las acciones permitidas del rol
  }
  class MenuAcciones {
    una operacion por accion
  }
  class ConsoleIO {
    lectura validada de enteros
  }
}

package "Interfaz grafica (Swing)" {
  class AppSwing {
    abre el login
  }
  class VentanaLogin {
    usuario y contrasena
  }
  class VentanaPrincipal {
    pestanias y botones segun el rol
  }
  class ModeloTabla {
    tabla de solo lectura
  }
  class Logo {
    icono dibujado por codigo
  }
}

class DatosIniciales
interface ServicioEventos
class GestorEventosEnVivo
class GestorRemoto

App --> Arranque : completo y servidor
App --> GestorRemoto : cliente
App --> MenuPorRol
App --> AppSwing
Arranque --> GestorEventosEnVivo
Arranque --> DatosIniciales
MenuPorRol --> MenuAcciones
MenuAcciones --> ConsoleIO
AppSwing --> VentanaLogin
VentanaLogin --> VentanaPrincipal
VentanaLogin --> Logo
VentanaPrincipal --> ModeloTabla
VentanaPrincipal --> Logo
MenuAcciones ..> ServicioEventos
VentanaPrincipal ..> ServicioEventos
GestorEventosEnVivo ..|> ServicioEventos
GestorRemoto ..|> ServicioEventos
@enduml
