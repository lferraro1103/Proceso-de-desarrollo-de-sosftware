@startuml
!include estilo.iuml
title Diagrama de clases: vistas y arranque

class App {
  main() : modo completo, servidor o cliente
}

class Arranque {
  arma el gestor y levanta el servidor
}

package "Consola" {
  class MenuPorRol {
    menu armado con las acciones permitidas del rol
  }
  class MenuAcciones {
    una operacion por accion
  }
  class ConsoleIO {
    lectura validada de enteros
  }
}

package "Interfaz grafica (Swing)" {
  class AppSwing {
    abre el login
  }
  class VentanaLogin {
    usuario y contrasena
  }
  class VentanaPrincipal {
    pestanias y botones segun el rol
  }
  class ModeloTabla {
    tabla de solo lectura
  }
  class Logo {
    icono dibujado por codigo
  }
  class Navegador {
    abre una direccion en el navegador
  }
}

class DatosIniciales
interface ServicioEventos
class GestorEventosEnVivo
class GestorRemoto

App "1" --> "0..1" Arranque : completo y servidor
App "1" --> "0..1" GestorRemoto : cliente
App "1" --> "0..1" MenuPorRol : consola
App "1" --> "0..1" AppSwing : ventana
Arranque "1" --> "1" GestorEventosEnVivo : crea
Arranque "1" ..> "0..1" DatosIniciales : si la base esta vacia
MenuPorRol "1" --> "1" MenuAcciones
MenuAcciones "1" --> "1" ConsoleIO
MenuAcciones ..> "1" Navegador
AppSwing "1" --> "1" VentanaLogin
VentanaLogin "1" --> "0..1" VentanaPrincipal : tras iniciar sesion
VentanaLogin "1" --> "1" Logo
VentanaPrincipal "1" *-- "4" ModeloTabla : usuarios, artistas, eventos y registros
VentanaPrincipal "1" --> "1" Logo
VentanaPrincipal ..> "1" Navegador
MenuAcciones "1" --> "1" ServicioEventos : gestor
VentanaPrincipal "1" --> "1" ServicioEventos : gestor
VentanaLogin "1" --> "1" ServicioEventos : gestor
GestorEventosEnVivo ..|> ServicioEventos
GestorRemoto ..|> ServicioEventos
@enduml
