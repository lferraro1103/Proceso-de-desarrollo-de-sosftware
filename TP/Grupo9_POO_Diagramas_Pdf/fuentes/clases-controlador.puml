@startuml
!include estilo.iuml
title Diagrama de clases: controlador y sus interfaces

interface ServicioEventos {
  lo que piden las vistas
}

interface ServicioSesion {
  +iniciarSesion(nombreUsuario : String, contrasena : String) : Cuenta
  +cerrarSesion() : void
  +getCuentaActual() : Cuenta
  +puede(accion : Accion) : boolean
  +accionesPermitidas() : List<Accion>
}

interface ServicioConsultas {
  +listarUsuarios() : List<Usuario>
  +listarArtistas() : List<Artista>
  +listarEventosVisibles() : List<Evento>
  +listarRegistros() : List<RegistroAcceso>
  +buscarEventoVisible(id : int) : Evento
  +obtenerTransmision(idEvento : int) : Transmision
  +actualizar() : void
}

interface ServicioComandos {
  +registrarUsuario(datos) : Usuario
  +registrarArtista(datos) : Artista
  +crearEvento(datos : DatosRecital, artista : Artista) : RecitalEnVivo
  +iniciarEvento(idEvento : int) : void
  +solicitarIngreso(idUsuario : int, idEvento : int) : RegistroAcceso
  +expulsarUsuario(idEvento : int, idUsuario : int) : Usuario
  +alternarActivo(idUsuario : int) : Usuario
  +vincularCalendario(idEvento : int, vinculo) : void
}

class GestorEventosEnVivo {
  -usuariosRegistrados : List<Usuario>
  -artistasRegistrados : List<Artista>
  -eventos : List<Evento>
  +autenticar(nombreUsuario, contrasena) : Cuenta
  +asumirSesion(cuenta : Cuenta) : void
  +urlCalendario(idEvento : int) : String
  +consultaDeTransmision(idEvento : int) : ConsultaTransmision
  +cargarDatos() : void
  +guardarDatos() : void
}

class ControlAcceso {
  -registros : List<RegistroAcceso>
  +procesarIngreso(usuario : Usuario, evento : Evento) : RegistroAcceso
  +registrarExpulsion(usuario : Usuario, evento : Evento) : void
}

class ControlSesion {
  -cuentaActual : Cuenta
  +iniciar(cuenta : Cuenta) : void
  +exigir(accion : Accion) : void
  +permite(accion : Accion) : boolean
}

class Permisos {
  -permitidas : Map<TipoUsuario, Set<Accion>>
  +permite(tipo : TipoUsuario, accion : Accion) : boolean
}

enum Accion {
  SOLICITAR_INGRESO
  EXPULSAR_USUARIO
  VINCULAR_CALENDARIO
  VER_TRANSMISION
  ...
}

class Usuario
class Artista
class Evento
class Cuenta
class RegistroAcceso
enum TipoUsuario

ServicioEventos --|> ServicioSesion
ServicioEventos --|> ServicioConsultas
ServicioEventos --|> ServicioComandos
GestorEventosEnVivo ..|> ServicioEventos
GestorEventosEnVivo "1" o-- "0..*" Usuario : usuariosRegistrados
GestorEventosEnVivo "1" o-- "0..*" Artista : artistasRegistrados
GestorEventosEnVivo "1" o-- "0..*" Evento : eventos
GestorEventosEnVivo "1" *-- "1" ControlAcceso : controlAcceso
GestorEventosEnVivo "1" *-- "1" ControlSesion : sesion
ControlAcceso "1" o-- "0..*" RegistroAcceso : registros
ControlSesion "1" --> "0..1" Cuenta : cuentaActual
ControlSesion "1" *-- "1" Permisos : permisos
Permisos "1" --> "1..*" Accion : permitidas por rol
Permisos "1" ..> "3" TipoUsuario : un conjunto por rol
@enduml
