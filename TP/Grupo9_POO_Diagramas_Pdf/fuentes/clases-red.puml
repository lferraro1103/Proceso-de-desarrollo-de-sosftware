@startuml
!include estilo.iuml
title Diagrama de clases: servidor, API y cliente remoto

package "Cliente" {
  class GestorRemoto {
    implementa ServicioEventos
    -conSesion : boolean
  }
  class ClienteHttp {
    -token : String
    token y errores del servidor
  }
  class EstadoLocal {
    copia de solo lectura
    objetos del modelo a partir de EstadoDto
  }
}

package "API compartida" {
  class Json
  class EstadoDto {
    cuenta, usuarios, artistas,
    eventos y registros
  }
}

package "Servidor" {
  class ServidorHttp {
    servidor HTTP del JDK
  }
  class ManejadorApi {
    /api/
  }
  class ManejadorCalendario {
    /calendario/
  }
  class Sesiones {
    token -> cuenta
  }
  class Instantanea {
    filtra lo visible segun el rol
  }
  class Conversor {
    modelo a DTO, sin contrasenas
  }
  class PublicadorHttp {
    implementa PublicadorCalendario
  }
  class CodigosCalendario {
    HMAC de cada cuenta
  }
  class ConfiguracionServidor {
    puerto, red y direccion publica
  }
  class ProcesoTunel {
    abre cloudflared para los calendarios
  }
}

package "Servicio aparte en Node" {
  class ServicioTransmision {
    servidor.js
    GET /transmision, /reproductor, /latido, /salida
  }
}

interface ServicioEventos
class GestorEventosEnVivo
class ClienteTransmision
class ProcesoServicio
class "cloudflared" as Cloudflared <<externo>>

GestorRemoto ..|> ServicioEventos
GestorEventosEnVivo ..|> ServicioEventos
GestorRemoto "1" --> "1" ClienteHttp : http
GestorRemoto "1" *-- "0..1" EstadoLocal : estado
EstadoLocal ..> "1" EstadoDto : se arma con
ClienteHttp ..> "1" Json
ClienteHttp "*" ..> "1" ManejadorApi : HTTP + JSON
ServidorHttp "1" --> "1" ManejadorApi
ServidorHttp "1" --> "1" ManejadorCalendario
ServidorHttp "1" --> "1" ConfiguracionServidor
ManejadorApi "1" *-- "1" Sesiones
ManejadorApi "1" --> "1" Instantanea
ManejadorApi "1" --> "1" GestorEventosEnVivo : gestor
ManejadorApi "1" --> "1" ClienteTransmision : proveedor
Instantanea ..> "1" Conversor
Instantanea ..> "1" EstadoDto : arma
ManejadorCalendario "1" --> "1" CodigosCalendario
ManejadorCalendario "1" --> "1" GestorEventosEnVivo
PublicadorHttp "1" --> "1" CodigosCalendario
PublicadorHttp "1" --> "1" ConfiguracionServidor
GestorEventosEnVivo "1" --> "1" ClienteTransmision : proveedorTransmision
ClienteTransmision "*" ..> "1" ServicioTransmision : HTTP
ProcesoServicio "1" ..> "0..1" ServicioTransmision : inicia y cierra
ProcesoTunel ..> "1" ConfiguracionServidor : usarUrlPublica
ProcesoTunel "1" ..> "0..1" Cloudflared : inicia y cierra
@enduml
