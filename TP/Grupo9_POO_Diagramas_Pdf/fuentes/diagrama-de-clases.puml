  }
  interface PublicadorCalendario {
    {abstract} +urlFeed(cuenta : Cuenta, evento : Evento) : String
  }
  interface ProveedorTransmision {
    {abstract} +buscar(consulta : ConsultaTransmision) : Transmision
    {abstract} +cerrar(espectador : String) : void
  }
  interface VinculoCalendario {
    {abstract} +getNombre() : String
    {abstract} +vincular(urlFeed : String) : void
  }
  class ConsultaTransmision <<record>> {
    -artista : String
    -inicio : LocalDateTime
    -espectador : String
  }
  class Transmision <<record>> {
    -titulo : String
    -url : String
  }
}

