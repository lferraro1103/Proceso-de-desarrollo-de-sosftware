@startuml
!include estilo.iuml
title Diagrama de clases: persistencia en SQLite

interface Persistencia {
  +guardar(gestor : GestorEventosEnVivo) : void
  +cargar(gestor : GestorEventosEnVivo) : void
}

class PersistenciaSqlite {
  guarda en una sola transaccion
}

class ConexionSqlite {
  abre la base y crea las tablas
}

class RepositorioUsuarios {
  tabla usuarios
}

class RepositorioArtistas {
  tabla artistas
}

class RepositorioEventos {
  tablas eventos, evento_artistas
  y evento_conectados
}

class RepositorioRegistros {
  tabla registros_acceso
}

class DatosIniciales {
  datos de prueba de la primera vez
}

class GestorEventosEnVivo {
  guarda despues de cada cambio
}

class Usuario
class Artista
class Evento
class RegistroAcceso

GestorEventosEnVivo "1" --> "1" Persistencia : persistencia
PersistenciaSqlite ..|> Persistencia
PersistenciaSqlite "1" *-- "1" RepositorioUsuarios
PersistenciaSqlite "1" *-- "1" RepositorioArtistas
PersistenciaSqlite "1" *-- "1" RepositorioEventos
PersistenciaSqlite "1" *-- "1" RepositorioRegistros
PersistenciaSqlite ..> "1" ConexionSqlite : abre una por operacion
RepositorioUsuarios ..> "0..*" Usuario : lee y escribe
RepositorioArtistas ..> "0..*" Artista : lee y escribe
RepositorioEventos ..> "0..*" Evento : lee y escribe
RepositorioRegistros ..> "0..*" RegistroAcceso : lee y escribe
DatosIniciales ..> "1" GestorEventosEnVivo : siembra si la base esta vacia
@enduml
