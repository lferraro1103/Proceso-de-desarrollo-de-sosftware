    {abstract} +buscar(consulta : ConsultaTransmision) : Transmision
    {abstract} +cerrar(espectador : String) : void
  }
  interface VinculoCalendario {
    {abstract} +getNombre() : String
    {abstract} +vincular(urlFeed : String) : void
